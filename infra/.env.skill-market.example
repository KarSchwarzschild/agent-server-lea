# Copy this file to infra/.env.skill-market and replace every CHANGE_ME value.
# External MySQL. Example: the existing 202.205.160.9:3307 database.
DB_HOST=202.205.160.9
DB_PORT=3307
DB_NAME=lea_platform
DB_USER=root
DB_PASSWORD=CHANGE_ME

# Prebuilt image tags. The server only pulls these images; it does not need the repository.
LEA_CONFIG_IMAGE=registry.example.com/lea-config:skill-v1
LEA_GATEWAY_IMAGE=registry.example.com/lea-gateway:skill-v1

# External JWT verification: the gateway fetches the public RSA keys from JWKS.
OIDC_ISSUER=https://passport-ai.ouchn.edu.cn
OIDC_JWKS_URL=https://passport-ai.ouchn.edu.cn/.well-known/openid-configuration/jwks
# The gateway verifies the selected tenant through this endpoint.
TENANT_MEMBERSHIP_URL=https://aibase-preview.ouc-online.com.cn/api/TenantUser/CurrUserTenants
# Generate a long random value; gateway and lea-config must share it.
LEA_INTERNAL_TOKEN=CHANGE_ME

# Huawei OBS S3-compatible credentials and bucket.
OBS_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
OBS_PUBLIC_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
OBS_REGION=cn-north-4
OBS_BUCKET=CHANGE_ME
OBS_ADDRESSING_STYLE=virtual
OBS_ACCESS_KEY=CHANGE_ME
OBS_SECRET_KEY=CHANGE_ME

SKILL_MARKET_PORT=8080

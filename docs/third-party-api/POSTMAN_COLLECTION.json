              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_file_id\": \"sess_file_456\",\n  \"filename\": \"final_report.pdf\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/sessions/{{session_id}}/files/publish",
              "host": ["{{base_url}}"],
              "path": ["sessions", "{{session_id}}", "files", "publish"]
            }
          }
        }

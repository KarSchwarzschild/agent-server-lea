# LEA Platform 环境配置示例
# 复制此文件为 .env 并填入实际值

# 环境切换: test / production
LEA_ENV=test

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lea-platform-test

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-secret-key-change-in-production

# 智能基座 API
LEA_TENANT_API_BASE=https://tenantapi-ai.ouchn.edu.cn
LEA_TENANT_API_KEY=
LEA_CHAT_APP_KEY=
LEA_DEFAULT_KB_ID=

# LLM 模型配置
LEA_MODEL_CHAT=qwen-max-latest
LEA_MODEL_ROUTING=glm-4-plus
LEA_MODEL_FALLBACK=glm-4-flash

# 文件存储（本地生成文件）
UPLOAD_DIR=./data/uploads
GENERATED_FILES_DIR=./data/generated_files

# MinIO / S3 对象存储
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lea-uploads

# OpenTelemetry（可选，不设置则输出到控制台）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ==================== 代码沙箱（E2B 协议，兼容 CubeSandbox）====================
# SANDBOX_BACKEND=mock 走本地 subprocess 假沙箱（开发/CI 无外部依赖）
# SANDBOX_BACKEND=e2b  走真沙箱（CubeSandbox / E2B Cloud）
SANDBOX_BACKEND=mock

# 真沙箱后端才需要（mock 模式忽略）
# 装依赖：cd packages/lea-graph && uv sync --extra sandbox
# CubeSandbox 优先，兜底 E2B（CUBE_* 优先于 E2B_*）
# CUBE_API_URL=http://127.0.0.1:3000
# CUBE_API_KEY=
# CUBE_TEMPLATE_ID=
# E2B_API_URL=
# E2B_API_KEY=

# ==================== 前端特性开关（Ph2/Ph3 点亮时改 true）====================
# frontend-user 用，vite dev 时读取。默认全 false（Ph1 只暴露主聊天 + 文档 + KB + 历史 + Profile）
# 把值改为 true 或 1 即可在 UI 露出对应模块。

# Ph2（后端就绪后开启）
# VITE_FEATURE_AGENT_PLAZA=false        # 助手广场（依赖 Agent CRUD API）
# VITE_FEATURE_ACADEMIC_SEARCH=false    # 文献检索（依赖 lea-rag 学术检索）
# VITE_FEATURE_REVIEW=false             # 综述系统（依赖 Research App）
# VITE_FEATURE_CHANNELS=false           # 消息渠道管理

# Ph3
# VITE_FEATURE_SUBSCRIPTION=false       # 智能订阅

# SSE 渲染开关（默认 true，可关掉降级）
# VITE_SHOW_THINKING=true               # 展示模型 reasoning content（o1/R1/Claude Extended Thinking）
# VITE_SHOW_TOOL_TIMELINE=true          # 展示工具调用时间线

# ==================== 前端启动 ====================
# 开发时前端本地跑（不进 docker-compose）
#   cd frontend-user && npm install && npm run dev  → http://localhost:9002
#   cd frontend-admin && npm install && npm run dev  → http://localhost:9001
# 两个前端都 proxy /api → http://127.0.0.1:8000 (lea-server)

# LEA Platform 环境配置示例
# 复制此文件为 .env 并填入实际值

# 环境切换: test / production
LEA_ENV=test

# 裸机运行时的内部服务地址。Docker/Kubernetes 部署应覆盖为服务名地址。
LEA_CONFIG_URL=http://127.0.0.1:8500
LEA_RAG_URL=http://127.0.0.1:8300
LEA_TOOLS_URL=http://127.0.0.1:8400
LEA_PARSER_URL=http://127.0.0.1:8600

# 私网部署的模型 Provider 必须按主机名显式放行，逗号分隔。不要使用 *。
# LEA_PROVIDER_HOST_ALLOWLIST=ollama.internal,model-gateway.internal

# 测试环境管理角色覆盖，只由 Gateway 使用。默认不启用；测试服务器 compose 默认
# 使用 admin。可选 disabled / admin / platform_admin，非 test 环境配置会拒绝启动。
# LEA_TEST_ADMIN_ROLE=admin

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lea-platform-test

# Redis
REDIS_URL=redis://localhost:6379/0

# lea-agent 单轮执行总时限（SSE 断线不会触发它）
LEA_AGENT_RUN_TIMEOUT=30m

# 执行模式：inline 保持当前单进程行为；temporal 由独立 Worker 执行长任务。
LEA_AGENT_EXECUTION_MODE=temporal
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
LEA_AGENT_TEMPORAL_TASK_QUEUE=lea-agent-runs
# MySQL outbox 未派发 Run 的补偿扫描间隔。
LEA_AGENT_DISPATCH_INTERVAL=2s
# Worker 故障转移时，等待旧 Worker 的 Redis 会话锁释放/过期的上限。
LEA_AGENT_RETRY_LOCK_WAIT=75s

# JWT
SECRET_KEY=your-secret-key-change-in-production

# 智能基座 API
LEA_TENANT_API_BASE=https://tenantapi-ai.ouchn.edu.cn
LEA_TENANT_API_KEY=tenant-45018b36afb04526b8e881292b6ea978
LEA_CHAT_APP_KEY=
LEA_DEFAULT_KB_ID=

# ==================== 知识库检索 ====================
# Embedding 模型（env 仅作 DB 为空时的 fallback）
# 正式配置通过 Admin API 写入 retrieval_models 表
LEA_EMBEDDING_MODEL=bge-large-zh-v1.5
LEA_EMBEDDING_API_BASE=https://tenantapi-ai.ouchn.edu.cn/v1/embeddings
LEA_EMBEDDING_DIM=1536

# Milvus 向量数据库
LEA_MILVUS_URI=http://localhost:19530
LEA_MILVUS_COLLECTION=lea_knowledge_v2

# Reranker（可选，不部署则自动跳过）
LEA_RERANKER_API_BASE=http://localhost:6006
LEA_RERANKER_ENABLED=true

# 检索策略
LEA_RAG_RETRIEVAL_TOP_K=10
LEA_RAG_RERANK_TOP_K=5
LEA_RAG_QUERY_OPTIMIZE=false
LEA_RAG_SECTION_BOOST=true

# LLM 模型配置
LEA_MODEL_CHAT=qwen-max-latest
LEA_MODEL_ROUTING=glm-4-plus
LEA_MODEL_FALLBACK=glm-4-flash

# 文件存储（本地生成文件）
UPLOAD_DIR=./data/uploads
GENERATED_FILES_DIR=./data/generated_files

# MinerU 文档解析
# 二选一：设 MINERU_URL 走本地自部署（同步），设 MINERU_TOKEN 走 mineru.net 云端（异步）
# MINERU_URL=http://localhost:8001
MINERU_TOKEN=sk-avF2b1pvsuGxSv1St07QRTENYjib14fGGkc9cwEA0RGuXvBw
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lea-uploads

# OpenTelemetry（可选，不设置则输出到控制台）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ==================== 代码沙箱（E2B 协议，兼容 CubeSandbox）====================
# SANDBOX_BACKEND=mock 走本地 subprocess 假沙箱（开发/CI 无外部依赖）
# SANDBOX_BACKEND=e2b  走真沙箱（CubeSandbox / E2B Cloud）
SANDBOX_BACKEND=mock

# 真沙箱后端才需要（mock 模式忽略）
# 装依赖：cd packages/lea-graph && uv sync --extra sandbox
# CubeSandbox 优先，兜底 E2B（CUBE_* 优先于 E2B_*）
# CUBE_API_URL=http://127.0.0.1:3000
# CUBE_API_KEY=
# CUBE_TEMPLATE_ID=
# E2B_API_URL=
# E2B_API_KEY=

# ==================== 记忆服务 ====================
# 部署模式: embedded（内嵌在 lea-server 中） / remote（独立服务）
LEA_MEMORY_MODE=embedded
# 独立部署时走统一检索服务（remote 模式才需要）
# LEA_RETRIEVAL_SERVICE_URL=http://localhost:8300

# 记忆 Embedding 配置（为空时 fallback 到 KB 的 LEA_EMBEDDING_* 配置）
# LEA_MEMORY_EMBEDDING_API_BASE=
# LEA_MEMORY_EMBEDDING_MODEL=
# LEA_MEMORY_EMBEDDING_DIM=

# 记忆 Milvus collection 名称
# LEA_MEMORY_MILVUS_COLLECTION=lea_user_memories

# ==================== 前端特性开关（Ph2/Ph3 点亮时改 true）====================
# frontend-user 用，vite dev 时读取。默认全 false（Ph1 只暴露主聊天 + 文档 + KB + 历史 + Profile）
# 把值改为 true 或 1 即可在 UI 露出对应模块。

# Ph2（后端就绪后开启）
# VITE_FEATURE_AGENT_PLAZA=false        # 助手广场（依赖 Agent CRUD API）
# VITE_FEATURE_ACADEMIC_SEARCH=false    # 文献检索（依赖 lea-rag 学术检索）
# VITE_FEATURE_REVIEW=false             # 综述系统（依赖 Research App）
# VITE_FEATURE_CHANNELS=false           # 消息渠道管理

# Ph3
# VITE_FEATURE_SUBSCRIPTION=false       # 智能订阅

# SSE 渲染开关（默认 true，可关掉降级）
# VITE_SHOW_THINKING=true               # 展示模型 reasoning content（o1/R1/Claude Extended Thinking）
# VITE_SHOW_TOOL_TIMELINE=true          # 展示工具调用时间线

# ==================== 前端启动 ====================
# 开发时前端本地跑（不进 docker-compose）
#   cd frontend-user && npm install && npm run dev  → http://localhost:9002
#   cd frontend-admin && npm install && npm run dev  → http://localhost:9001
# 两个前端都 proxy /api → http://127.0.0.1:8000 (lea-server)

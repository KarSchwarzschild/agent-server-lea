# lea-rag 降级开关与超时配置
# 添加到 lea-rag 容器的环境变量

# === 降级开关 ===
ENABLE_KB_SEARCH=true
ENABLE_VECTOR_DB=true

# === 超时配置 ===
VECTOR_DB_TIMEOUT=10s
PARSE_DOCUMENT_TIMEOUT=600s


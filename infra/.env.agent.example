# lea-agent 降级开关与超时配置
# 添加到 lea-agent 容器的环境变量

# === 降级开关 ===
ENABLE_KB_SEARCH=true
ENABLE_MEMORY_SEARCH=true
ENABLE_EXTERNAL_TOOLS=true

# === 超时配置 ===
KB_SEARCH_TIMEOUT=5s
MEMORY_SEARCH_TIMEOUT=3s
TOOL_EXECUTION_TIMEOUT=30s

# === 缓存配置 ===
ENABLE_CACHE=true
CACHE_BASE_TTL=5m
CACHE_JITTER=60s
CACHE_NULL_TTL=1m

# === Redis 配置 ===
# REDIS_URL=redis://redis:6379/0

